@model BloomCast.Models.UserCreateViewModel
@{
    ViewData["Title"] = "Nuevo usuario";
}

<style>
  :root {
    --sage:#7a9b76; --sage-l:#a8c4a4; --cream:#f5f0e8;
    --bark:#3d2b1f; --bark-l:#6b4c38; --gold:#c9a85c;
    --rose:#c97d6e; --white:#fdfaf5;
    --shadow:0 4px 28px rgba(61,43,31,.10);
  }

  /* ── Breadcrumb ── */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: .5rem;
    font-size: .8rem;
    color: var(--bark-l);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a { color: var(--sage); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }
  .breadcrumb span { color: #c0b4a4; }

  /* ── Page header ── */
  .page-header { margin-bottom: 1.8rem; }
  .page-header h1 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2rem;
    font-weight: 300;
    color: var(--bark);
  }
  .page-header h1 em { color: var(--sage); font-style: italic; }
  .page-header p { color: var(--bark-l); font-size: .85rem; margin-top: .3rem; }

  /* ── Form card ── */
  .form-card {
    background: var(--white);
    border-radius: 16px;
    box-shadow: var(--shadow);
    max-width: 640px;
  }

  .form-section {
    padding: 1.6rem 1.8rem;
    border-bottom: 1px solid #ece5da;
  }
  .form-section:last-of-type { border-bottom: none; }

  .section-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.05rem;
    font-weight: 400;
    color: var(--bark);
    margin-bottom: 1.1rem;
    display: flex;
    align-items: center;
    gap: .4rem;
  }

  /* ── Form fields ── */
  .field { margin-bottom: 1.1rem; }
  .field:last-child { margin-bottom: 0; }

  .field label {
    display: block;
    font-size: .78rem;
    font-weight: 500;
    color: var(--bark-l);
    text-transform: uppercase;
    letter-spacing: .05em;
    margin-bottom: .4rem;
  }

  .field-required::after { content: ' *'; color: var(--rose); }

  .f-input {
    width: 100%;
    background: var(--cream);
    border: 1.5px solid #ddd4c4;
    border-radius: 8px;
    padding: .6rem .85rem;
    font-family: 'DM Sans', sans-serif;
    font-size: .9rem;
    color: var(--bark);
    outline: none;
    transition: border-color .2s, box-shadow .2s;
  }
  .f-input:focus {
    border-color: var(--sage);
    box-shadow: 0 0 0 3px rgba(122,155,118,.15);
  }
  .f-input.input-error { border-color: var(--rose); }

  .field-error {
    color: var(--rose);
    font-size: .78rem;
    margin-top: .3rem;
  }

  /* ── 2 col grid ── */
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  @@media(max-width:520px) { .grid-2 { grid-template-columns: 1fr; } }

  /* ── Password strength ── */
  .pwd-wrap { position: relative; }
  .pwd-toggle {
    position: absolute;
    right: .7rem;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1rem;
    color: var(--bark-l);
    padding: .2rem;
    line-height: 1;
  }
  .strength-bar {
    display: flex;
    gap: 3px;
    margin-top: .4rem;
  }
  .strength-seg {
    height: 3px;
    flex: 1;
    border-radius: 2px;
    background: #e0d8cc;
    transition: background .3s;
  }
  .strength-label { font-size: .72rem; color: var(--bark-l); margin-top: .2rem; }

  /* ── Toggle switch ── */
  .toggle-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--cream);
    border-radius: 8px;
    padding: .75rem 1rem;
  }
  .toggle-label { font-size: .87rem; color: var(--bark); }
  .toggle-sub   { font-size: .75rem; color: var(--bark-l); margin-top: .1rem; }

  .toggle {
    position: relative;
    width: 42px;
    height: 24px;
    flex-shrink: 0;
  }
  .toggle input { opacity: 0; width: 0; height: 0; }
  .toggle-slider {
    position: absolute;
    inset: 0;
    background: #d0c8b8;
    border-radius: 24px;
    cursor: pointer;
    transition: background .2s;
  }
  .toggle-slider::before {
    content: '';
    position: absolute;
    width: 18px; height: 18px;
    left: 3px; top: 3px;
    background: white;
    border-radius: 50%;
    transition: transform .2s;
    box-shadow: 0 1px 4px rgba(0,0,0,.2);
  }
  .toggle input:checked + .toggle-slider { background: var(--sage); }
  .toggle input:checked + .toggle-slider::before { transform: translateX(18px); }

  /* ── Form footer ── */
  .form-footer {
    padding: 1.2rem 1.8rem;
    display: flex;
    gap: .8rem;
    align-items: center;
    justify-content: flex-end;
    background: var(--cream);
    border-top: 1px solid #ece5da;
    border-radius: 0 0 16px 16px;
  }

  .btn-primary {
    background: var(--sage);
    color: var(--white);
    border: none;
    padding: .6rem 1.4rem;
    border-radius: 8px;
    font-family: 'DM Sans', sans-serif;
    font-size: .9rem;
    font-weight: 500;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    transition: background .2s, transform .15s;
  }
  .btn-primary:hover { background: #698f65; transform: translateY(-1px); }

  .btn-ghost {
    background: transparent;
    color: var(--bark-l);
    border: 1px solid #d4c9b8;
    padding: .55rem 1.1rem;
    border-radius: 8px;
    font-family: 'DM Sans', sans-serif;
    font-size: .88rem;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    transition: all .2s;
  }
  .btn-ghost:hover { border-color: var(--sage); color: var(--sage); text-decoration: none; }

  .val-summary {
    background: #fdf0ee;
    color: #8a2e22;
    border-left: 4px solid var(--rose);
    border-radius: 8px;
    padding: .8rem 1rem;
    font-size: .85rem;
    margin: 1rem 1.8rem;
  }
  .val-summary ul { padding-left: 1.2rem; margin: .3rem 0 0; }
  .val-summary li { margin-bottom: .15rem; }
</style>

<!-- Breadcrumb -->
<div class="breadcrumb">
  <a href="/Users">Usuarios</a>
  <span>›</span>
  <span>Nuevo usuario</span>
</div>

<!-- Header -->
<div class="page-header">
  <h1>Nuevo <em>Usuario</em></h1>
  <p>Completa los datos para crear un acceso al sistema</p>
</div>

<!-- Validation summary -->
@if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
{
  <div class="val-summary">
    ⚠️ Revisa los siguientes errores:
    <ul>
      @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
      {
        <li>@error.ErrorMessage</li>
      }
    </ul>
  </div>
}

<form method="post" asp-action="Create">
  @Html.AntiForgeryToken()
  <div class="form-card">

    <!-- Información personal -->
    <div class="form-section">
      <div class="section-title">👤 Información personal</div>

      <div class="field">
        <label class="field-required" asp-for="NombreCompleto">Nombre completo</label>
        <input asp-for="NombreCompleto" class="f-input @(ViewData.ModelState["NombreCompleto"]?.Errors.Any() == true ? "input-error" : "")"
               placeholder="Ej. María López" autocomplete="name" />
        <span asp-validation-for="NombreCompleto" class="field-error"></span>
      </div>

      <div class="field">
        <label class="field-required" asp-for="Correo">Correo electrónico</label>
        <input asp-for="Correo" class="f-input @(ViewData.ModelState["Correo"]?.Errors.Any() == true ? "input-error" : "")"
               type="email" placeholder="correo@ejemplo.com" autocomplete="email" />
        <span asp-validation-for="Correo" class="field-error"></span>
      </div>
    </div>

    <!-- Contraseña -->
    <div class="form-section">
      <div class="section-title">🔑 Contraseña</div>

      <div class="grid-2">
        <div class="field">
          <label class="field-required" asp-for="Password">Contraseña</label>
          <div class="pwd-wrap">
            <input asp-for="Password" id="pwd" class="f-input @(ViewData.ModelState["Password"]?.Errors.Any() == true ? "input-error" : "")"
                   type="password" placeholder="Mín. 8 caracteres" autocomplete="new-password"
                   oninput="checkStrength(this.value)" />
            <button type="button" class="pwd-toggle" onclick="togglePwd('pwd', this)">👁</button>
          </div>
          <div class="strength-bar">
            <div class="strength-seg" id="s1"></div>
            <div class="strength-seg" id="s2"></div>
            <div class="strength-seg" id="s3"></div>
            <div class="strength-seg" id="s4"></div>
          </div>
          <div class="strength-label" id="sLabel"></div>
          <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <div class="field">
          <label class="field-required" asp-for="ConfirmarPassword">Confirmar contraseña</label>
          <div class="pwd-wrap">
            <input asp-for="ConfirmarPassword" id="pwd2" class="f-input @(ViewData.ModelState["ConfirmarPassword"]?.Errors.Any() == true ? "input-error" : "")"
                   type="password" placeholder="Repite la contraseña" autocomplete="new-password" />
            <button type="button" class="pwd-toggle" onclick="togglePwd('pwd2', this)">👁</button>
          </div>
          <span asp-validation-for="ConfirmarPassword" class="field-error"></span>
        </div>
      </div>
    </div>

    <!-- Permisos -->
    <div class="form-section">
      <div class="section-title">🛡 Permisos y estado</div>

      <div class="field">
        <label class="field-required" asp-for="RolId">Rol</label>
        <select asp-for="RolId" class="f-input @(ViewData.ModelState["RolId"]?.Errors.Any() == true ? "input-error" : "")"
                asp-items="ViewBag.Roles">
          <option value="">— Seleccionar rol —</option>
        </select>
        <span asp-validation-for="RolId" class="field-error"></span>
      </div>

      <div class="toggle-row">
        <div>
          <div class="toggle-label">Usuario activo</div>
          <div class="toggle-sub">El usuario podrá iniciar sesión en el sistema</div>
        </div>
        <label class="toggle">
          <input asp-for="Activo" type="checkbox" checked />
          <span class="toggle-slider"></span>
        </label>
      </div>
    </div>

    <!-- Footer -->
    <div class="form-footer">
      <a href="/Users" class="btn-ghost">← Cancelar</a>
      <button type="submit" class="btn-primary">✓ Crear usuario</button>
    </div>

  </div>
</form>

@section Scripts {
<script>
  function togglePwd(id, btn) {
    const inp = document.getElementById(id);
    const isText = inp.type === 'text';
    inp.type = isText ? 'password' : 'text';
    btn.textContent = isText ? '👁' : '🙈';
  }

  function checkStrength(val) {
    let score = 0;
    if (val.length >= 8)  score++;
    if (/[A-Z]/.test(val)) score++;
    if (/[0-9]/.test(val)) score++;
    if (/[^A-Za-z0-9]/.test(val)) score++;

    const colors = ['', '#c97d6e', '#c9a85c', '#7a9b76', '#4a7a45'];
    const labels = ['', 'Débil', 'Regular', 'Buena', 'Fuerte'];

    for (let i = 1; i <= 4; i++) {
      const seg = document.getElementById('s' + i);
      seg.style.background = i <= score ? colors[score] : '#e0d8cc';
    }
    document.getElementById('sLabel').textContent = val.length > 0 ? labels[score] : '';
    document.getElementById('sLabel').style.color = colors[score] || 'var(--bark-l)';
  }
</script>
}
