@model IEnumerable<BloomCast.Contracts.Users.UserResponse>
@{
    ViewData["Title"] = "Usuarios";
}

<style>
  :root {
    --sage:#7a9b76; --sage-l:#a8c4a4; --cream:#f5f0e8;
    --bark:#3d2b1f; --bark-l:#6b4c38; --gold:#c9a85c;
    --rose:#c97d6e; --white:#fdfaf5;
    --shadow:0 4px 28px rgba(61,43,31,.10);
  }

  /* ── Page header ── */
  .page-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 1.8rem;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .page-header h1 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2.1rem;
    font-weight: 300;
    color: var(--bark);
    line-height: 1;
  }
  .page-header h1 em { color: var(--sage); font-style: italic; }
  .page-header p { color: var(--bark-l); font-size: .85rem; margin-top: .3rem; }

  /* ── Btn ── */
  .btn-primary {
    background: var(--sage);
    color: var(--white);
    border: none;
    padding: .55rem 1.2rem;
    border-radius: 8px;
    font-family: 'DM Sans', sans-serif;
    font-size: .88rem;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    transition: background .2s, transform .15s;
  }
  .btn-primary:hover { background: #698f65; transform: translateY(-1px); color: var(--white); text-decoration: none; }

  .btn-ghost {
    background: transparent;
    color: var(--bark-l);
    border: 1px solid #d4c9b8;
    padding: .45rem .9rem;
    border-radius: 6px;
    font-family: 'DM Sans', sans-serif;
    font-size: .8rem;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    transition: all .2s;
  }
  .btn-ghost:hover { border-color: var(--sage); color: var(--sage); text-decoration: none; }

  .btn-icon {
    background: transparent;
    border: none;
    padding: .35rem .55rem;
    border-radius: 6px;
    cursor: pointer;
    font-size: .95rem;
    transition: background .15s, transform .15s;
    line-height: 1;
  }
  .btn-icon:hover { background: rgba(61,43,31,.07); transform: scale(1.12); }
  .btn-icon.danger:hover { background: rgba(201,125,110,.15); }

  /* ── Alert banners ── */
  .alert {
    padding: .75rem 1.1rem;
    border-radius: 10px;
    font-size: .87rem;
    margin-bottom: 1.4rem;
    display: flex;
    align-items: center;
    gap: .6rem;
  }
  .alert-success { background: #eef7ed; color: #2e6b2a; border-left: 4px solid var(--sage); }
  .alert-error   { background: #fdf0ee; color: #8a2e22; border-left: 4px solid var(--rose); }

  /* ── Filters card ── */
  .filters-card {
    background: var(--white);
    border-radius: 14px;
    padding: 1.2rem 1.4rem;
    box-shadow: var(--shadow);
    margin-bottom: 1.4rem;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: flex-end;
  }
  .filter-group { display: flex; flex-direction: column; gap: .3rem; }
  .filter-group label { font-size: .73rem; color: var(--bark-l); text-transform: uppercase; letter-spacing: .05em; font-weight: 500; }

  .f-input {
    background: var(--cream);
    border: 1px solid #ddd4c4;
    border-radius: 7px;
    padding: .45rem .75rem;
    font-family: 'DM Sans', sans-serif;
    font-size: .87rem;
    color: var(--bark);
    outline: none;
    transition: border-color .2s;
    min-width: 180px;
  }
  .f-input:focus { border-color: var(--sage); }

  .filter-actions { display: flex; gap: .6rem; align-items: flex-end; margin-left: auto; }

  /* ── Table card ── */
  .table-card {
    background: var(--white);
    border-radius: 14px;
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .table-card table {
    width: 100%;
    border-collapse: collapse;
  }
  .table-card thead tr {
    background: var(--cream);
    border-bottom: 2px solid #ece5da;
  }
  .table-card th {
    padding: .85rem 1.2rem;
    text-align: left;
    font-size: .72rem;
    font-weight: 600;
    color: var(--bark-l);
    text-transform: uppercase;
    letter-spacing: .06em;
    white-space: nowrap;
  }
  .table-card td {
    padding: .9rem 1.2rem;
    font-size: .87rem;
    color: var(--bark);
    vertical-align: middle;
    border-bottom: 1px solid #f0e9df;
  }
  .table-card tbody tr:last-child td { border-bottom: none; }
  .table-card tbody tr { transition: background .12s; }
  .table-card tbody tr:hover { background: #faf6ef; }

  /* ── Avatar ── */
  .user-cell { display: flex; align-items: center; gap: .8rem; }
  .avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--sage);
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1rem;
    font-weight: 600;
    flex-shrink: 0;
  }
  .user-name  { font-weight: 500; color: var(--bark); font-size: .9rem; }
  .user-email { font-size: .76rem; color: var(--bark-l); }

  /* ── Badges ── */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    padding: .2rem .65rem;
    border-radius: 20px;
    font-size: .73rem;
    font-weight: 600;
    letter-spacing: .02em;
    white-space: nowrap;
  }
  .badge-admin { background: rgba(201,168,92,.18); color: #7a5a10; }
  .badge-user  { background: rgba(122,155,118,.18); color: #3a6030; }
  .badge-other { background: rgba(61,43,31,.10); color: var(--bark-l); }
  .badge-on  { background: rgba(122,155,118,.18); color: #3a6030; }
  .badge-off { background: rgba(201,125,110,.15); color: #8a2e22; }
  .badge-mfa { background: rgba(201,168,92,.15); color: #7a5a10; }
  .badge-nomfa { background: rgba(61,43,31,.07); color: #9a8070; }

  /* ── Actions ── */
  .actions-cell { display: flex; gap: .2rem; align-items: center; }

  /* ── Empty state ── */
  .empty-state {
    text-align: center;
    padding: 3.5rem 1rem;
    color: var(--bark-l);
  }
  .empty-state .e-icon { font-size: 3rem; margin-bottom: .6rem; }
  .empty-state p { font-size: .9rem; }

  /* ── Delete modal ── */
  .modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(61,43,31,.45);
    backdrop-filter: blur(3px);
    z-index: 1000;
    align-items: center;
    justify-content: center;
  }
  .modal-overlay.active { display: flex; }
  .modal-box {
    background: var(--white);
    border-radius: 16px;
    padding: 2rem;
    max-width: 400px;
    width: 90%;
    box-shadow: 0 20px 60px rgba(61,43,31,.25);
    text-align: center;
  }
  .modal-icon { font-size: 2.8rem; margin-bottom: .8rem; }
  .modal-box h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--bark);
    margin-bottom: .5rem;
  }
  .modal-box p { color: var(--bark-l); font-size: .88rem; margin-bottom: 1.5rem; }
  .modal-box strong { color: var(--bark); }
  .modal-btns { display: flex; gap: .8rem; justify-content: center; }
  .btn-danger {
    background: var(--rose);
    color: white;
    border: none;
    padding: .55rem 1.3rem;
    border-radius: 8px;
    font-family: 'DM Sans', sans-serif;
    font-size: .88rem;
    font-weight: 500;
    cursor: pointer;
    transition: background .2s;
  }
  .btn-danger:hover { background: #b56657; }

  /* ── Pagination / count ── */
  .table-footer {
    padding: .8rem 1.2rem;
    border-top: 1px solid #f0e9df;
    font-size: .78rem;
    color: var(--bark-l);
    background: var(--cream);
  }

  @@media(max-width:768px) {
    .filters-card { flex-direction: column; }
    .filter-actions { margin-left: 0; width: 100%; }
    .table-card { overflow-x: auto; }
  }
</style>

<!-- Header -->
<div class="page-header">
  <div>
    <h1>Gestión de <em>Usuarios</em></h1>
    <p>Administra los accesos al sistema BloomCast</p>
  </div>
  <a href="/Users/Create" class="btn-primary">＋ Nuevo usuario</a>
</div>

<!-- Alerts -->
@if (TempData["Success"] != null)
{
  <div class="alert alert-success">✅ @Html.Raw(TempData["Success"])</div>
}
@if (TempData["Error"] != null)
{
  <div class="alert alert-error">⚠️ @Html.Raw(TempData["Error"])</div>
}

<!-- Filters -->
<form method="get" asp-action="Index">
  <div class="filters-card">
    <div class="filter-group">
      <label>Buscar</label>
      <input type="text" name="search" class="f-input" placeholder="Nombre o correo…"
             value="@ViewBag.Search" />
    </div>
    <div class="filter-group">
      <label>Rol</label>
      <select name="rolId" class="f-input">
        <option value="">Todos los roles</option>
        @foreach (SelectListItem item in (ViewBag.Roles as SelectList ?? new SelectList(new List<object>())))
        {
          <option value="@item.Value" selected="@item.Selected">@item.Text</option>
        }
      </select>
    </div>
    <div class="filter-group">
      <label>Estado</label>
            <select name="activo" class="f-input">
                @if (ViewBag.Activo == null)
                {
                    <option value="" selected>Todos</option>
                    <option value="true">Activos</option>
                    <option value="false">Inactivos</option>
                }
                else if (ViewBag.Activo == true)
                {
                    <option value="">Todos</option>
                    <option value="true" selected>Activos</option>
                    <option value="false">Inactivos</option>
                }
                else
                {
                    <option value="">Todos</option>
                    <option value="true">Activos</option>
                    <option value="false" selected>Inactivos</option>
                }
            </select>
    </div>
    <div class="filter-actions">
      <button type="submit" class="btn-primary">🔍 Filtrar</button>
      <a href="/Users" class="btn-ghost">✕ Limpiar</a>
    </div>
  </div>
</form>

<!-- Table -->
<div class="table-card">
  @if (!Model.Any())
  {
    <div class="empty-state">
      <div class="e-icon">👥</div>
      <p>No se encontraron usuarios con los filtros aplicados.</p>
    </div>
  }
  else
  {
    <table>
      <thead>
        <tr>
          <th>Usuario</th>
          <th>Rol</th>
          <th>Estado</th>
          <th>MFA</th>
          <th style="text-align:right">Acciones</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var u in Model)
        {
          var initials = string.Join("", u.NombreCompleto.Split(' ')
                           .Where(w => w.Length > 0)
                           .Take(2)
                           .Select(w => w[0].ToString().ToUpper()));
                    var rolCss = @u.RolNombre == "Administrador" ? "badge-admin"
                     : @u.RolNombre == "usuario" ? "badge-user"
                     : "badge-other";

          <tr>
            <td>
              <div class="user-cell">
                <div class="avatar">@initials</div>
                <div>
                  <div class="user-name">@u.NombreCompleto</div>
                  <div class="user-email">@u.Correo</div>
                </div>
              </div>
            </td>
                        <td><span class="badge @rolCss">@(@u.RolNombre ?? "—")</span></td>
            <td>
              @if (u.Activo)
              {
                <span class="badge badge-on">● Activo</span>
              }
              else
              {
                <span class="badge badge-off">○ Inactivo</span>
              }
            </td>
            <td>
              @if (u.MfaHabilitado)
              {
                <span class="badge badge-mfa">🔐 Activo</span>
              }
              else
              {
                <span class="badge badge-nomfa">— Sin MFA</span>
              }
            </td>
            <td>
              <div class="actions-cell" style="justify-content:flex-end">
                <a href="/Users/Edit/@u.Id" class="btn-icon" title="Editar">✏️</a>
                <button type="button" class="btn-icon danger"
                        onclick="confirmarEliminar(@u.Id, '@u.NombreCompleto.Replace("'", "\\'")')"
                        title="Eliminar">🗑️</button>
              </div>
            </td>
          </tr>
        }
      </tbody>
    </table>
    <div class="table-footer">
      @Model.Count() usuario(s) encontrado(s)
    </div>
  }
</div>

<!-- Delete modal -->
<div class="modal-overlay" id="deleteModal">
  <div class="modal-box">
    <div class="modal-icon">🗑️</div>
    <h3>Eliminar usuario</h3>
    <p>¿Estás seguro de eliminar a <strong id="modalNombre"></strong>? Esta acción no se puede deshacer.</p>
    <div class="modal-btns">
      <button type="button" class="btn-ghost" onclick="cerrarModal()">Cancelar</button>
      <form method="post" id="deleteForm" style="margin:0">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn-danger">Eliminar</button>
      </form>
    </div>
  </div>
</div>

@section Scripts {
<script>
  function confirmarEliminar(id, nombre) {
    document.getElementById('modalNombre').textContent = nombre;
    document.getElementById('deleteForm').action = '/Users/Delete/' + id;
    document.getElementById('deleteModal').classList.add('active');
  }
  function cerrarModal() {
    document.getElementById('deleteModal').classList.remove('active');
  }
  document.getElementById('deleteModal').addEventListener('click', function(e) {
    if (e.target === this) cerrarModal();
  });
</script>
}
