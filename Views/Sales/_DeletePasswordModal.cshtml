@{
    var ventaId = ViewBag.VentaId;
    var ventaInfo = ViewBag.VentaInfo;
}

<div class="modal-overlay" id="deletePasswordModal" style="display: flex;">
    <div class="modal-box" style="max-width: 420px;">
        <div class="modal-icon">🔐</div>
        <h3>Verificación de Administrador</h3>
        <p style="margin-bottom: 1rem;">
            Estás intentando eliminar:<br />
            <strong style="color: var(--rose);">@ventaInfo</strong>
        </p>
        <p style="font-size: 0.85rem; color: var(--bark-l); margin-bottom: 1.2rem;">
            Esta acción restaurará el stock de los productos.<br />
            <strong>Esta operación no se puede deshacer.</strong>
        </p>

        <form id="deletePasswordForm" method="post" action="/Sales/DeleteWithPassword">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@ventaId" />

            <div style="text-align: left; margin-bottom: 1.5rem;">
                <label style="display: block; font-size: 0.8rem; color: var(--bark-l); margin-bottom: 0.5rem; font-weight: 500;">
                    Contraseña de Administrador
                </label>
                <input type="password"
                       name="password"
                       id="adminPasswordInput"
                       class="f-input"
                       style="width: 100%;"
                       placeholder="Ingrese su contraseña"
                       autocomplete="off"
                       required />
                <small style="font-size: 0.7rem; color: var(--bark-l);">
                    Se requiere autenticación para eliminar ventas
                </small>
            </div>

            <div id="passwordErrorMsg" class="alert alert-error" style="display: none; margin-bottom: 1rem; font-size: 0.8rem;">
                ⚠️ <span id="errorText"></span>
            </div>

            <div id="loadingSpinner" style="display: none; text-align: center; margin-bottom: 1rem;">
                <div style="display: inline-block; width: 20px; height: 20px; border: 2px solid var(--sage); border-top-color: transparent; border-radius: 50%; animation: spin 0.6s linear infinite;"></div>
                <span style="margin-left: 0.5rem; font-size: 0.85rem;">Verificando...</span>
            </div>

            <div class="modal-btns">
                <button type="button" class="btn-ghost" onclick="cerrarModalPassword()">
                    Cancelar
                </button>
                <button type="submit" class="btn-danger" id="confirmDeleteBtn">
                    🗑️ Confirmar Eliminación
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

<script>
    function cerrarModalPassword() {
        const modal = document.getElementById('deletePasswordModal');
        if (modal) modal.remove();
    }

    document.getElementById('deletePasswordForm').addEventListener('submit', async function(e) {
        e.preventDefault();

        const password = document.getElementById('adminPasswordInput').value;
        if (!password) {
            mostrarError('Por favor ingrese la contraseña de administrador');
            return;
        }

        const submitBtn = document.getElementById('confirmDeleteBtn');
        const spinner = document.getElementById('loadingSpinner');
        const errorDiv = document.getElementById('passwordErrorMsg');

        // Deshabilitar botón y mostrar loading
        submitBtn.disabled = true;
        spinner.style.display = 'block';
        errorDiv.style.display = 'none';

        const formData = new FormData(this);

        try {
            const response = await fetch(this.action, {
                method: 'POST',
                body: formData
            });

            const html = await response.text();

            // Crear un elemento temporal para procesar la respuesta
            const tempDiv = document.createElement('div');
            tempDiv.innerHTML = html;

            // Buscar alertas en la respuesta
            const successAlert = tempDiv.querySelector('.alert-success');
            const errorAlert = tempDiv.querySelector('.alert-error');

            if (successAlert) {
                // Éxito - mostrar mensaje y recargar
                mostrarMensajeTemporal(successAlert.innerText, 'success');
                setTimeout(() => {
                    window.location.href = '/Sales';
                }, 1500);
            } else if (errorAlert) {
                mostrarError(errorAlert.innerText);
                submitBtn.disabled = false;
                spinner.style.display = 'none';
            } else {
                // Si la redirección fue exitosa, recargar
                if (response.redirected) {
                    window.location.href = response.url;
                } else {
                    mostrarError('Error al procesar la solicitud');
                    submitBtn.disabled = false;
                    spinner.style.display = 'none';
                }
            }
        } catch (error) {
            console.error('Error:', error);
            mostrarError('Error de conexión con el servidor');
            submitBtn.disabled = false;
            spinner.style.display = 'none';
        }
    });

    function mostrarError(mensaje) {
        const errorDiv = document.getElementById('passwordErrorMsg');
        const errorText = document.getElementById('errorText');
        errorText.innerText = mensaje;
        errorDiv.style.display = 'flex';

        // Auto-ocultar después de 4 segundos
        setTimeout(() => {
            errorDiv.style.display = 'none';
        }, 4000);
    }

    function mostrarMensajeTemporal(mensaje, tipo) {
        // Crear un toast o alerta flotante
        const alertDiv = document.createElement('div');
        alertDiv.className = `alert alert-${tipo}`;
        alertDiv.style.position = 'fixed';
        alertDiv.style.top = '20px';
        alertDiv.style.right = '20px';
        alertDiv.style.zIndex = '9999';
        alertDiv.style.maxWidth = '350px';
        alertDiv.style.boxShadow = '0 4px 12px rgba(0,0,0,0.15)';
        alertDiv.innerHTML = tipo === 'success' ? '✅ ' : '⚠️ ' + mensaje;
        document.body.appendChild(alertDiv);

        setTimeout(() => alertDiv.remove(), 3000);
    }

    // Permitir Enter en el campo de contraseña
    document.getElementById('adminPasswordInput').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            document.getElementById('deletePasswordForm').dispatchEvent(new Event('submit'));
        }
    });

    // Cerrar modal al hacer clic fuera
    document.getElementById('deletePasswordModal').addEventListener('click', function(e) {
        if (e.target === this) cerrarModalPassword();
    });
</script>