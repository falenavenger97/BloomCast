@model MfaViewModel
@{
    Layout = null;
    ViewData["Title"] = "Configurar 2FA";
}
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BloomCast — Configurar 2FA</title>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing:border-box; margin:0; padding:0; }
    :root { --sage:#7a9b76; --cream:#f5f0e8; --bark:#3d2b1f; --bark-l:#6b4c38; --gold:#c9a85c; --rose:#c97d6e; --white:#fdfaf5; }
    body { font-family:'DM Sans',sans-serif; min-height:100vh; background:var(--cream); display:flex; align-items:center; justify-content:center; padding:2rem; }
    .card {
      background:var(--white);
      border-radius:16px;
      padding:3rem 2.5rem;
      width:100%;
      max-width:460px;
      box-shadow:0 8px 40px rgba(61,43,31,.12);
      text-align:center;
    }
    .badge {
      display:inline-flex; align-items:center; gap:.4rem;
      background:rgba(122,155,118,.12); border:1px solid rgba(122,155,118,.3);
      border-radius:20px; padding:.3rem .9rem; font-size:.78rem;
      color:var(--sage); font-weight:500; margin-bottom:1.2rem;
    }
    h2 { font-family:'Cormorant Garamond',serif; font-size:1.9rem; font-weight:400; color:var(--bark); margin-bottom:.5rem; }
    .sub { color:var(--bark-l); font-size:.85rem; line-height:1.6; margin-bottom:1.8rem; }

    .steps { display:flex; justify-content:center; gap:1.5rem; margin-bottom:1.8rem; }
    .step { display:flex; flex-direction:column; align-items:center; gap:.3rem; }
    .step-num { width:28px; height:28px; border-radius:50%; background:var(--sage); color:#fff; font-size:.78rem; font-weight:600; display:flex; align-items:center; justify-content:center; }
    .step-txt { font-size:.72rem; color:var(--bark-l); max-width:70px; text-align:center; line-height:1.3; }

    .qr-container {
      background:var(--cream);
      border:2px dashed #c8b89a;
      border-radius:12px;
      padding:1.2rem;
      margin:0 auto 1.8rem;
      display:inline-block;
    }
    .qr-container img { width:180px; height:180px; border-radius:4px; }

    .otp-wrap { display:flex; justify-content:center; gap:.6rem; margin-bottom:1.5rem; }
    .otp-input {
      width:46px; height:56px;
      border:2px solid #d8cfc0;
      border-radius:10px;
      font-size:1.4rem;
      font-weight:500;
      text-align:center;
      background:var(--cream);
      color:var(--bark);
      outline:none;
      transition:border-color .2s, box-shadow .2s;
    }
    .otp-input:focus { border-color:var(--sage); box-shadow:0 0 0 3px rgba(122,155,118,.18); }
    #Codigo { display:none; }

    .btn-primary {
      width:100%;
      padding:.85rem;
      background:var(--bark);
      color:var(--gold);
      border:none;
      border-radius:8px;
      font-family:'Cormorant Garamond',serif;
      font-size:1.1rem;
      font-weight:600;
      letter-spacing:.06em;
      cursor:pointer;
      transition:background .2s;
    }
    .btn-primary:hover { background:var(--bark-l); }

    .error-msg { background:#fff0ee; border:1px solid #f5c0b0; border-radius:8px; padding:.6rem 1rem; margin-bottom:1.2rem; color:#8b3a2a; font-size:.85rem; }
  </style>
</head>
<body>
<div class="card">
  <div class="badge">🔒 Configuración inicial · Seguridad</div>
  <h2>Activa la verificación 2FA</h2>
  <p class="sub">Tu cuenta requiere autenticación de dos factores. Escanea el QR con Google Authenticator, Authy o cualquier app TOTP.</p>

  <div class="steps">
    <div class="step"><div class="step-num">1</div><div class="step-txt">Instala app autenticadora</div></div>
    <div class="step"><div class="step-num">2</div><div class="step-txt">Escanea el código QR</div></div>
    <div class="step"><div class="step-num">3</div><div class="step-txt">Ingresa el código de 6 dígitos</div></div>
  </div>

  @if (Model.QrCodeBase64 != null)
  {
    <div class="qr-container">
      <img src="data:image/png;base64,@Model.QrCodeBase64" alt="QR 2FA" />
    </div>
  }

  @if (!ViewData.ModelState.IsValid)
  {
    <div class="error-msg">@Html.ValidationSummary(false)</div>
  }

  <form method="post" asp-controller="Account" asp-action="MfaSetup" id="setupForm">
    @Html.AntiForgeryToken()

    <div class="otp-wrap">
      @for (int i = 0; i < 6; i++)
      {
        <input class="otp-input" type="text" maxlength="1" inputmode="numeric" pattern="[0-9]" data-index="@i" />
      }
    </div>

    <input asp-for="Codigo" id="Codigo" />
    <input asp-for="EsConfiguracion" type="hidden" value="true" />

    <button type="submit" class="btn-primary">Confirmar y acceder →</button>
  </form>
</div>

<script>
  const boxes = document.querySelectorAll('.otp-input');
  const hidden = document.getElementById('Codigo');
  boxes.forEach((box, i) => {
    box.addEventListener('input', () => {
      box.value = box.value.replace(/[^0-9]/g,'');
      if (box.value && i < 5) boxes[i+1].focus();
      hidden.value = [...boxes].map(b=>b.value).join('');
    });
    box.addEventListener('keydown', e => { if(e.key==='Backspace'&&!box.value&&i>0) boxes[i-1].focus(); });
    box.addEventListener('paste', e => {
      const t = e.clipboardData.getData('text').replace(/\D/g,'').slice(0,6);
      [...t].forEach((ch,j)=>{ if(boxes[j]) boxes[j].value=ch; });
      hidden.value=[...boxes].map(b=>b.value).join('');
      boxes[Math.min(t.length,5)].focus();
      e.preventDefault();
    });
  });
  document.getElementById('setupForm').addEventListener('submit',()=>{
    hidden.value=[...boxes].map(b=>b.value).join('');
  });
</script>
</body>
</html>
