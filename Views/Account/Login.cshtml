@model LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Iniciar sesión";
}
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BloomCast — Acceso</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin:0; padding:0; }
    :root {
      --sage:   #7a9b76;
      --sage-l: #a8c4a4;
      --cream:  #f5f0e8;
      --bark:   #3d2b1f;
      --bark-l: #6b4c38;
      --rose:   #c97d6e;
      --gold:   #c9a85c;
      --white:  #fdfaf5;
    }
    body {
      font-family: 'DM Sans', sans-serif;
      min-height: 100vh;
      display: grid;
      grid-template-columns: 1fr 1fr;
      background: var(--cream);
    }
    /* left decorative panel */
    .panel-art {
      background: var(--bark);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 3rem;
      position: relative;
      overflow: hidden;
    }
    .panel-art::before {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 60% 60% at 30% 70%, rgba(122,155,118,.25) 0%, transparent 70%),
        radial-gradient(ellipse 40% 50% at 80% 20%, rgba(201,168,92,.12) 0%, transparent 60%);
    }
    .art-orchid {
      font-size: 7rem;
      animation: float 4s ease-in-out infinite;
      position: relative;
      z-index: 1;
    }
    @@keyframes float {
      0%,100% { transform: translateY(0); }
      50%      { transform: translateY(-14px); }
    }
    .art-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 3.2rem;
      font-weight: 300;
      color: var(--gold);
      letter-spacing: .1em;
      margin-top: 1.5rem;
      position: relative;
      z-index: 1;
    }
    .art-title em { color: var(--sage-l); font-style: italic; }
    .art-sub {
      color: #a08060;
      margin-top: .6rem;
      font-size: .9rem;
      letter-spacing: .06em;
      position: relative;
      z-index: 1;
    }
    /* blobs */
    .blob {
      position: absolute;
      border-radius: 50%;
      filter: blur(60px);
      opacity: .15;
    }
    .blob-1 { width:280px; height:280px; background:var(--sage);  top:-60px;  left:-60px; }
    .blob-2 { width:200px; height:200px; background:var(--gold);  bottom:40px; right:-40px; }

    /* right form panel */
    .panel-form {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 3rem;
    }
    .form-card {
      width: 100%;
      max-width: 400px;
    }
    .form-card h2 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 2rem;
      font-weight: 400;
      color: var(--bark);
      margin-bottom: .4rem;
    }
    .form-card p.sub { color: var(--bark-l); font-size: .85rem; margin-bottom: 2rem; }

    .form-group { margin-bottom: 1.3rem; }
    label { display: block; font-size: .8rem; font-weight: 500; color: var(--bark-l); margin-bottom: .4rem; letter-spacing: .04em; text-transform: uppercase; }
    input[type=email], input[type=password] {
      width: 100%;
      padding: .75rem 1rem;
      border: 1.5px solid #d8cfc0;
      border-radius: 8px;
      background: var(--white);
      color: var(--bark);
      font-family: 'DM Sans', sans-serif;
      font-size: .95rem;
      transition: border-color .2s, box-shadow .2s;
      outline: none;
    }
    input:focus { border-color: var(--sage); box-shadow: 0 0 0 3px rgba(122,155,118,.15); }

    .btn-primary {
      width: 100%;
      padding: .85rem;
      background: var(--bark);
      color: var(--gold);
      border: none;
      border-radius: 8px;
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.1rem;
      font-weight: 600;
      letter-spacing: .06em;
      cursor: pointer;
      transition: background .2s, transform .1s;
      margin-top: .5rem;
    }
    .btn-primary:hover { background: var(--bark-l); transform: translateY(-1px); }
    .btn-primary:active { transform: translateY(0); }

    .validation-summary { background:#fff0ee; border:1px solid #f5c0b0; border-radius:8px; padding:.75rem 1rem; margin-bottom:1.2rem; color: #8b3a2a; font-size:.875rem; }

    .field-error { color: var(--rose); font-size: .78rem; margin-top: .25rem; }

    .divider { display:flex; align-items:center; gap:.75rem; margin:1.5rem 0; color:#b0a090; font-size:.8rem; }
    .divider::before, .divider::after { content:''; flex:1; height:1px; background:#e0d8cc; }

    .hint { background:rgba(122,155,118,.08); border:1px solid rgba(122,155,118,.25); border-radius:8px; padding:.75rem 1rem; font-size:.8rem; color:var(--bark-l); line-height:1.5; }
    .hint strong { color:var(--sage); }

    @@media (max-width: 720px) {
      body { grid-template-columns: 1fr; }
      .panel-art { display:none; }
    }
  </style>
</head>
<body>
  <div class="panel-art">
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="art-orchid">🌺</div>
    <div class="art-title">Bloom<em>Cast</em></div>
    <p class="art-sub">Inteligencia floral · Predicción de demanda</p>
  </div>

  <div class="panel-form">
    <div class="form-card">
      <h2>Bienvenido de nuevo</h2>
      <p class="sub">Ingresa tus credenciales para continuar</p>

      @if (!ViewData.ModelState.IsValid)
      {
        <div class="validation-summary">
          @Html.ValidationSummary(false)
        </div>
      }

      <form method="post" asp-controller="Account" asp-action="Login">
        @Html.AntiForgeryToken()

        <div class="form-group">
          <label asp-for="Correo">Correo electrónico</label>
          <input asp-for="Correo" type="email" placeholder="tu@correo.com" autocomplete="email" />
          <span asp-validation-for="Correo" class="field-error"></span>
        </div>

        <div class="form-group">
          <label asp-for="Password">Contraseña</label>
          <input asp-for="Password" type="password" placeholder="••••••••" autocomplete="current-password" />
          <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <button type="submit" class="btn-primary">Iniciar sesión →</button>
      </form>

      <div class="divider">configuración inicial</div>

      <div class="hint">
        <strong>Primera vez:</strong> después del login se te pedirá configurar la autenticación de dos factores con Google Authenticator u otra app TOTP.
      </div>
    </div>
  </div>
</body>
</html>
