		<None Remove="BloomCast.Api\**\*" />

		<Compile Remove="BloomCast.Contracts\**\*.cs" />
		<Content Remove="BloomCast.Contracts\**\*" />
		<EmbeddedResource Remove="BloomCast.Contracts\**\*" />
		<None Remove="BloomCast.Contracts\**\*" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="BloomCast.Contracts\BloomCast.Contracts.csproj" />
	</ItemGroup>
</Project>
